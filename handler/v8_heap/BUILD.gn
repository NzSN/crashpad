import("../../build/crashpad_buildconfig.gni")

# Collects a minimal V8 heap snapshot (V8HE user minidump stream) for JIT frame
# resolution from stack-only dumps. Linked into the handler via the
# UserStreamDataSources vector registered in run_as_crashpad_handler_win.cc.
source_set("v8_heap_capture") {
  sources = [
    "v8_heap_capture.cc",
    "v8_heap_capture.h",
    "v8_heap_format.h",
    "v8_heap_user_stream_data_source.cc",
    "v8_heap_user_stream_data_source.h",
  ]

  public_configs = [ "../..:crashpad_config" ]

  public_deps = [
    "..:common",
    "../../minidump",
    "../../snapshot",
    "../../third_party/mini_chromium:base",
  ]
}

source_set("v8_heap_capture_test") {
  testonly = true

  sources = [ "v8_heap_user_stream_data_source_unittest.cc" ]

  public_configs = [ "../..:crashpad_config" ]

  deps = [
    ":v8_heap_capture",
    "../../snapshot:test_support",
    "../../test",
    "../../third_party/googletest",
    "../../third_party/mini_chromium:base",
  ]
}
